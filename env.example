# SignalArc Cheers — environment variable template
# Copy this file to .env and fill in the values for your deployment.
# NEVER commit .env — it is excluded by .gitignore.
#
# All VITE_* variables are browser-safe (public).
# Do not add server-side secrets or private keys here.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (from Project Settings > API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable (anon) key — browser-safe, visible to users
# This is the "anon public" key from Project Settings > API > Project API keys
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Registry contract ─────────────────────────────────────────────────────────
# Deployed CheersGiftRegistry address on Arc Mainnet (chain ID 5042).
# Leave empty to show "On-chain gifting is coming soon" and disable transactions.
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
